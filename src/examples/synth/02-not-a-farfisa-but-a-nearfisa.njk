{% endblock %}

{% block controls %}
<switch-blam to=".vibrato" prop="bypass" reverse>
  <label>
    vibrato
    <input type="checkbox">
  </label>
</switch-blam>
<switch-blam to=".tremolo" prop="bypass" reverse>
  <label>
    tremolo
    <input type="checkbox">
  </label>
</switch-blam>
<switch-blam to="#nearfisaGain" prop="gain" value="0" ramp="3" reverse>
  <label>
    organ off
    <input type="checkbox">
  </label>
</switch-blam>
<switch-blam to=".drums" prop="suspend" reverse>
  <label>
    drums
    <input type="checkbox">
  </label>
</switch-blam>
<switch-blam to="#nearfisaTrack" prop="part" value="#fast">
  <label>
    part 2
    <input type="checkbox">
  </label>
</switch-blam>
<dial-blam to="#nearfisa carrier-blam" prop="feedback">
  <label>
    osc<br>feedback
    <input type="range" min="0" max="1000">
  </label>
</dial-blam>
{% endblock %}