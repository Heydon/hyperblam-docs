---
title: Super-Mega-Ultra Saw
bpm: 90
elements: 
  - Synth 
  - carrier
---

{% extends 'layouts/example-synth.njk' %}

{% block audio %}
<chain-blam id="bus">
  <reverb-blam cutoff="2000">
    <sample-blam src="{{site.basedir}}/static/sounds/IRs/cavern.mp3"></sample-blam>
  </reverb-blam>
  <limiter-blam></limiter-blam>
  <analyser-blam id="analyser"></analyser-blam>
</chain-blam>

<synth-blam detune="-1200" notes="C4 E4 F#4 G4">
  <carrier-blam curve="0 0, 1 1, 0 6" release="6" type="sawtooth">
    <lfo-blam prop="gain" gain="0.5" beats="0.61"></lfo-blam>
    <chain-blam out="bus">
      <gain-blam gain="0.5">
        <lfo-blam prop="gain" gain="0.5" beats="17"></lfo-blam>
      </gain-blam>
      <pan-blam pan="0.3"></pan-blam>
    </chain-blam>
    <blam-blam prop="type" value="triangle|sawtooth|square|sine"></blam-blam>
  </carrier-blam>
  <carrier-blam curve="0 0, 1 2, 0 11" release="6" type="sawtooth" offset="7">
    <lfo-blam prop="gain" gain="0.5" beats="0.3"></lfo-blam>
    <chain-blam out="bus">
      <filter-blam freq="7000">
        <lfo-blam prop="freq" gain="6500" q="5" beats="9"></lfo-blam>
      </filter-blam>
      <pan-blam pan="-0.3"></pan-blam>
    </chain-blam>
    <blam-blam prop="type" value="triangle|sawtooth|square|sine"></blam-blam>
  </carrier-blam>
  <lfo-blam prop="gain" gain="0.5" beats="0.25">
    <lfo-blam prop="beats" gain="5" beats="5"></lfo-blam>
  </lfo-blam>
  <lfo-blam prop="detune" gain="25" beats="1">
    <lfo-blam prop="gain" gain="20" beats="23"></lfo-blam>
  </lfo-blam>
</synth-blam>

<tap-blam to="synth-blam" prop="play">
  <button>Play note</button>
</tap-blam>
{% endblock %}

{% block dialog %}

{% renderTemplate "md" %}

{% endrenderTemplate %}

{% endblock %}

{% block controls %}
{% endblock %}