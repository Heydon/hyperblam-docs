{% block audio %}
<chain-blam id="bus">
  <reverb-blam mix="0.25">
    <sample-blam src="{{site.basedir}}/static/sounds/IRs/plate.mp3"></sample-blam>
  </reverb-blam>
  <analyser-blam id="analyser"></analyser-blam>
</chain-blam>

<synth-blam id="theramin" notes="C4" detune="0" out="bus">
  <carrier-blam curve="0 0, 1 2" release="2"></carrier-blam>
  <lfo-blam prop="detune" gain="25" beats="2.5"></lfo-blam>
  <lfo-blam class="vibrato" prop="detune" gain="0" beats="0.21"></lfo-blam>
  <lfo-blam class="vibrato" prop="detune" gain="0" beats="0.47"></lfo-blam>
</synth-blam>

<div class="l-cluster">
  <tap-blam to="#theramin" prop="play">
    <button>start</button>
    <blam-blam to="rings-blam" prop="start" once></blam-blam>
  </tap-blam>
  <tap-blam id="move" to="#theramin" prop="detune" ramp="1" value="-500|1200|2400|300|1500|2700|3600">
    <button>move</button>
    <blam-blam to="#move" prop="ramp" value="2|1|0.5|0.5"></blam-blam>
    <blam-blam to=".vibrato" prop="gain" ramp="1" value="0|0|0|0|100|200" chance="0.333"></blam-blam>
  </tap-blam>
  <tap-blam to="#theramin" prop="stop">
    <button>stop</button>
  </tap-blam>
</div>
