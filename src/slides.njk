            </div>
          </div>
          <blam-blam to="#crush" for="slideNext" prop="bypass" value="true"></blam-blam>
          <blam-blam to="#beat" for="slideNext" prop="stop"></blam-blam>
          <kbd-blam id="closedHatKey" key="1" to="#hat" prop="play" value="1|2|3">
            <blam-blam to=".hat-top" prop="--hatHeight" value="1%"></blam-blam>
          </kbd-blam>
          <kbd-blam id="openHatKey" key="2" to="#hat" prop="play" value="4">
            <blam-blam to=".hat-top" prop="--hatHeight" value="-27%"></blam-blam>
          </kbd-blam>
          <blam-blam from="#hat" to="#hiHatSketch" prop="class" value="u-jolt"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/choke1.svg" alt="sounds left to ring out versus sounds choked (foreshortened)">
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/choke2.svg" alt="sounds left to ring out versus sounds choked with 0.05 second ramp">
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/hat_tracks.svg" alt="showing the two separate hat tracks: one for the closed hat with 10 quarter beats and one for the open hat with just one beat but a low probability">
            </div>
          </div>
          <blam-blam to=".hatTrack" for="slideNext" prop="suspend" value="false"></blam-blam>
          <blam-blam to=".hatTrack" for="slideNext" prop="solo" value="true"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam to="#beat" for="slideNext" prop="play"></blam-blam>
        </section>

        <section id="oneSecond" class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/one_second.mp4"></video>
          </media-blam>
          <blam-blam to="#beat" for="slideWaiting" prop="stop"></blam-blam>
        </section>

        <section>
          <div class="l-screen">
            <div class="l-frame">
              <rings-blam 
                class="u-squiggle hypnoVis"
                analyser="#bossAnalyser"
                id="withHatRings"
                fps="9"
                ratio="1/1"
                style="inline-size: 100%"
                count="8"
              >
