  <span class="u-hl">&lt;analyser-elem>&lt;/analyser-elem></span> <span class="u-special">(pre)</span>
  &lt;filter-blam freq="2000">&lt;/filter-blam>
  <span class="u-hl">&lt;analyser-elem>&lt;/analyser-elem></span> <span class="u-special">(post)</span>
&lt;/chain-blam></code></pre>              
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/blue_peter_spiders.mp4"></video>
          </media-blam>
        </section>

        <section data-speech="Time to hydrate again. You must hydrate regularly. If you don't hydrate at least once every 23 minutes, you’re a fecking eejit. I can tell you haven't been hydrating. The absolute state of you. A pork fecking scratching has a higher water content than you do. Get that water in you now, or so help me God. You dried up, water dodging fecking clown." data-voice="Moira" data-pause="5">
          <video class="u-mono" src="{{site.basedir}}/static/video/bottle.mp4" loop></video>
          <div class="l-screen">
            <div class="l-frame u-squiggle">
              <h2 class="u-alert u-tilt"><span class="u-blocked u-impact">HYDRATION BREAK</span></h2>
            </div>
          </div>
          <blam-blam to="#cowbells" prop="stop" event="slideNext" once></blam-blam>
          <blam-blam to="#rhodesSequencer" prop="play" event="slideNext" once></blam-blam>
        </section>

        <section class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/beethoven.mp4"></video>
          </media-blam>
          <blam-blam to="#rhodesSequencer" prop="stop" event="slideNext" once></blam-blam>
        </section>
      </div>  

      <!-- video bus -->
      <chain-blam id="garbleBus">
        <saturator-blam id="garble" mode="4" amount="71" mix="0" lowcut="500" highcut="8000"></saturator-blam>
        <gain-blam id="garbleGain" gain="3" bypass></gain-blam>
      </chain-blam>

      <chain-blam id="crushBus">
        <gain-blam id="crushGain" gain="0.35" bypass>
          <lfo-blam type="square" beats="0.009" gain="0.35">
            <blam-blam from="#cowbell" prop="beats" value="0.005~0.01" chance="0.6"></blam-blam>
          </lfo-blam>
        </gain-blam>
      </chain-blam>

      <!-- instruments -->
      <pads-blam id="stabs" gain="0.6" bank="stabBank">
        <blam-blam from="section:not(.u-no-stab)" prop="play" event="slideNext"></blam-blam>
      </pads-blam>

      <pads-blam id="radio" gain="0.07" detune="0" loop>
        <bank-blam>
          <sample-blam src="{{site.basedir}}/static/sounds/slides/radio.mp3"></sample-blam>
        </bank-blam>
        <lfo-blam id="radioSpeed" prop="detune" gain="1200" beats="3">
          <blam-blam from="body" prop="beats" value="0.01~4" event="slideWaiting"></blam-blam>
        </lfo-blam>
        <blam-blam from="body" prop="detune" value="0~4000" event="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="play" event="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="stop" event="slideChange"></blam-blam>
        <blam-blam from="body" to="#garble" prop="mix" value="1" event="slideWaiting"></blam-blam>
        <blam-blam from="body" to="#garbleGain" prop="gain" value="3" event="slideWaiting"></blam-blam>
        <blam-blam from="body" to="#garble" prop="mix" value="0" event="slideChange"></blam-blam>
        <blam-blam from="body" to="#garbleGain" prop="gain" value="1" event="slideChange"></blam-blam>
        <blam-blam from="body" to="#crushGain" prop="bypass" event="slideWaiting"></blam-blam>
        <blam-blam from="body" to="#crushGain" prop="bypass" event="slideChange"></blam-blam>
      </pads-blam>

      <pads-blam id="cowbell" bank="cowBank" choke="0.05"> 
        <chain-blam out="crushBus">
          <analyser-blam id="cowbellAnal"></analyser-blam>
        </chain-blam>
        <blam-blam id="cowLength" prop="length" value="0.01|0.02|1|1" bypass></blam-blam>  
      </pads-blam>

      <pads-blam id="cowbellReverse" reverse="0.65" bank="cowBank" gain="0.45">    
        <blam-blam prop="detune" value="-2400|0|400|-1200|-1200|-800|-600|-500|-200"></blam-blam> 
        <chain-blam>
          <echo-blam id="cowEcho" mix="1" beats="1.5" feeback="0.5" cutoff="3000"></echo-blam>
          <reverb-blam id="cowVerb">
            <sample-blam src="{{site.basedir}}/static/sounds/IRs/stadium.mp3"></sample-blam>
          </reverb-blam>
          <limiter-blam></limiter-blam>
          <gain-blam id="reverseGain" gain="1"></gain-blam>
          <analyser-blam id="reverseAnal" smoothing="0.3"></analyser-blam>
        </chain-blam>
        <lfo-blam prop="detune" gain="30"></lfo-blam>
        <envelope-blam prop="gain" curve="0 0, 1 0.25, 1 0.4, 0 0.9"></envelope-blam>
      </pads-blam>

      <notes-blam bank="rhodesBank" id="rhodes" notes="E3 F#3 G#3 B3 G#4 D4" gain="5">
        <chain-blam out="garbleBus">
          <filter-blam freq="3000">
            <lfo-blam prop="freq" beats="4.3" gain="2700" q="5"></lfo-blam>
          </filter-blam>
          <reverb-blam mix="0.5">
            <sample-blam src="{{site.basedir}}/static/sounds/IRs/stadium.mp3"></sample-blam>
          </reverb-blam>
        </chain-blam>
        <lfo-blam prop="detune" gain="35" beats="1.5"></lfo-blam>
      </notes-blam>

      <!-- sequencers -->
      <sequencer-blam id="cowbells">
        <track-blam id="cowbellTrack" to="#cowbell" chance="0">
          <bar-blam s="?"></bar-blam>
        </track-blam>
      </sequencer-blam>

      <sequencer-blam id="rhodesSequencer">
        <track-blam id="rhodesTrack" to="#rhodes" chance="0.9">
          <bar-blam s="E3 0 0 0 G#3 B3 0 G#4"></bar-blam>
          <bar-blam s="? 0 0 0 ? ? 0 ?"></bar-blam>
        </track-blam>
      </sequencer-blam>

      <sequencer-blam id="cowbellsAmb">
        <track-blam id="cowbellAmbTrack" to="#cowbellReverse" chance="0.4">
          <bar-blam s="?"></bar-blam>
        </track-blam>
      </sequencer-blam>

      <!-- banks -->

      <bank-blam id="stabBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-03.mp3"></sample-blam>
      </bank-blam>

      <bank-blam id="cowBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-01.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-02.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-03.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-04.mp3" reverse></sample-blam>
      </bank-blam>

      <bank-blam id="rhodesBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-01.mp3" root="E3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-02.mp3" root="E3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-03.mp3" root="E3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-04.mp3" root="E3"></sample-blam>
      </bank-blam>      
    </audio-blam>

    <script type="module">
      import { random } from '{{ site.basedir }}/static/hyperblam/src/tools/random.js';

      const utter = elem => {
        let text = elem.dataset.speech;
        let voiceData = elem.dataset.voice;
        let pause = elem.dataset.pause;
        let voice;
        if (voiceData) {
          voice = window.voices.find(v => v.name === voiceData);
        } else {
          voice = random.oneOf(window.voices);
        }
        let utterance = new SpeechSynthesisUtterance(text);
        utterance.voice = voice;
        utterance.volume = 0.6;
        window.speechTimeout = window.setTimeout(() => {
          speech.speak(utterance);
        }, pause ? parseInt(pause) * 1000 : 0);
      };

      const narrated = [...document.querySelectorAll('[data-speech]:not(section)')];
      narrated.forEach(elem => {
        elem.addEventListener('mouseover', () => {
          let text = elem.dataset.speech;
          utter(elem);
        });
      });

      window.speech = window.speechSynthesis;
      speech.addEventListener('voiceschanged', () => {
        window.voices = speech.getVoices().filter(voice => ['en-IE', 'en-GB'].includes(voice.lang) && voice.localService);
      });

      const fire = (name, data, target = window, bubbles = false) => {
        let event = new CustomEvent(name, {
          detail: data,
          bubbles: bubbles
        });

        target.dispatchEvent(event);
      }

      const slides = [...document.querySelectorAll('section')];
      const videos = [...document.querySelectorAll('video')];

      slides.forEach((s, i) => {
        s.hidden = true;
      });

      const slideEvents = (oldSlide, newSlide) => {
        fire('slideChange', {}, document.body);
        oldSlide && fire('slidePrev', {}, oldSlide);
        fire('slideNext', {}, newSlide);
      }
      
      window.addEventListener('blamready', () => {
        let startSlide;
        if (window.location.hash) {
          startSlide = slides.find(s => {
            return s.id && window.location.hash.includes(s.id);
          });
        } else {
          startSlide = slides[0];
        }
        startSlide.hidden = false;
        slideEvents(null, startSlide);

        document.addEventListener('keydown', e => {
          let thisSlide = document.querySelector('section:not([hidden])');
          if (!event.key.includes('Arrow')) {
            return;
          }
          if (document.activeElement.tagName === 'INPUT') {
            return;
          }
          let back = ['Up', 'Left'].some(key => e.key.includes(key));
          let newDir = back ? 'previous' : 'next';
          let newSlide = thisSlide[`${newDir}ElementSibling`];
          if (!newSlide) {
            return;
          }
          if (!window.waiting) {
            window.speech.cancel();
            thisSlide.classList.add('u-wait');
            window.waiting = true;
            window.lastKey = e.key;
            fire('slideWaiting', {}, document.body);
            return;
          }
          if (window.lastKey !== e.key) {
            return;  
          }
          slides.forEach(slide => slide.hidden = true);
          clearTimeout(window.speechTimeout);
          thisSlide.classList.remove('u-wait');
          window.waiting = newSlide.hidden = false;
          if (newSlide.dataset.speech) {
            utter(newSlide);
          }
          videos.forEach(video => {
            video.pause();
            video.currentTime = 0;
          });
          let newVideo = newSlide.querySelector('video');
          newVideo && newVideo.play();

          slideEvents(thisSlide, newSlide);
        });

        videos.forEach(video => {
          video.addEventListener('play', event => {
            event.stopPropagation();
          });
        });
      });
    </script>
    <script type="module" src="{{site.basedir}}/{{site.hyperblampath}}"></script>
  </body>
</html>