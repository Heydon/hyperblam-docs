<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Making HTML Make Music</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="{{site.basedir}}/static/css/fonts.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{site.basedircdn}}/static/css/fonts.css"></noscript>
    <link rel="preload" href="{{site.basedir}}/static/css/slides.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{site.basedir}}/static/css/slides.css"></noscript>
    <link rel="icon" type="image/svg+xml" href="{{site.basedir}}/static/images/favicon.svg" sizes="any">
    <style>
      :root{--color-fore:#fff;--color-back:#000;color:var(--color-fore);background-color:var(--color-back);filter: brightness(0.85);line-height:1.5}.l-flow>*+*{margin-block-start:var(--s-l)}.l-flow>p:not(:has(img))+p:not(:has(img)){margin-block-start:var(--s-s)}.l-view{min-block-size:100dvh;display:flex;flex-direction:column;margin:0}.l-view main{margin:var(--s-m) var(--s-s)}.l-skip:not(:focus-visible){transform:translateY(-200%)}.l-skip{outline:0;display:block;position:absolute;z-index:200;inset:0 0 auto 0;text-align:center;padding:var(--s-s);color:var(--color-back);background-color:var(--color-fore)}
    </style>
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" version="1.1" style="block-size: 0; overflow: hidden; position: absolute;">
      <defs>
        <filter id="warp-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.009" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.005" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.007" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-4" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.004" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="noise-big-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.006" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" />
        </filter>
        <filter id="noise-big-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.008" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="15" />
        </filter>
        <filter id="noise-big-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.004" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="20" />
        </filter>
        <filter id="noise-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.02" numOctaves="1" result="noise" seed="2"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" />
        </filter>
        <filter id="noise-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.01" numOctaves="1" result="noise" seed="3"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" />
        </filter>
        <filter id="noise-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.002" numOctaves="1" result="noise" seed="4"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" />
        </filter>
        <filter id="distort-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.001 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="90"/>
        </filter>
        <filter id="distort-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.009 0.3" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="110"/>
        </filter>
        <filter id="distort-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.003 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="200"/>
        </filter>
        <filter id="distort-4" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.007 0.2" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="100"/>
        </filter>
        <filter id="distort-5" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.001 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="70"/>
        </filter>
      </defs>
    </svg>
    <audio-blam bpm="90">
      <div>

<!-- slides -->
        <section>
          <div class="l-screen">
            <div class="l-frame">
              <h1 class="u-squiggle">Making HTML<br>Make Music</h1>
              <p class="u-tilt">with <strong>Heydon</strong> &amp; <strong>Moira</strong></p>
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/intro_clean.mp4"></video>
          </media-blam>
        </section>

        <section data-speech="an HTML button. Labelled cowbell." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <tap-blam to="#cowbell" prop="play" value="1">
                <button>cowbell</button>
              </tap-blam>
<pre><code>&lt;pad-blam id="cowbell">
  &lt;bank-blam>
    &lt;sample-blam src="<span class="u-hl">cowbell-01.mp3</span>">&lt;/sample-blam>
  &lt;/bank-blam>
&lt;/pad-blam></code></pre>
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/drum_machine.svg" alt="drum machine with a single drum pad highlighted.">
            </div>
          </div>
        </section>

        <section data-speech="another cowbell button. With multiple samples." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <tap-blam to="#cowbell" prop="play">
                <button>cowbell</button>
              </tap-blam>
<pre><code>&lt;pad-blam id="cowbell">
  &lt;bank-blam>
    &lt;sample-blam src="<span class="u-hl">cowbell-01.mp3</span>">&lt;/sample-blam>
    &lt;sample-blam src="<span class="u-hl">cowbell-02.mp3</span>">&lt;/sample-blam>
    &lt;sample-blam src="<span class="u-hl">cowbell-03.mp3</span>">&lt;/sample-blam>
    &lt;sample-blam src="<span class="u-hl">cowbell-04.mp3</span>">&lt;/sample-blam>
  &lt;/bank-blam>
&lt;/pad-blam></code></pre>
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/mute.svg" alt="two cowbells; one is muted to shorten its waveform">
            </div>
          </div>          
        </section>

        <section id="lengthSlide" data-speech="Yet another fecking cowbell button." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <tap-blam to="#cowbell" prop="play">
                <button>cowbell</button>
              </tap-blam>
<pre><code>&lt;blam-blam prop="length" value="0.01|0.02|1|1">&lt;/blam-blam></code></pre>
            </div>
          </div>
          <blam-blam to="#cowLength" prop="bypass" for="slideNext" once></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/illustrations/sequencing_spiderman.svg" alt="spiderman pointing at himself.">
            </div>
          </div>
        </section>

        <section data-speech="Mary Mother of God. More fecking cowbells." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <dial-blam to="#cowbellTrack" prop="chance">
                <label>
                  more cowbell
                  <input type="range" min="0.0" max="1.0" step="any">
                </label>
              </dial-blam>
<pre><code>&lt;sequencer-blam>
  &lt;track-blam <span class="u-hl">chance="<display-blam from="#cowbellTrack" prop="chance" places="2"></display-blam>"</span>>
    &lt;bar-blam s="?">&lt;/bar-blam>
  &lt;/track-blam>
&lt;sequencer-blam></code></pre>
            </div>
          </div>
          <blam-blam to="#beat" for="slideNext" prop="play"></blam-blam>
          <blam-blam to="#crush" for="slideWaiting" prop="bypass" value="false"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/kick_snare.svg" alt="kick and snare tracks">
            </div>
          </div>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam to="#crush" for="slideNext" prop="bypass" value="true"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <media-blam out="garbleBus">
              <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/okay_dont_tell_me.mp4"></video>
            </media-blam>
          </div>
          <blam-blam to="#beat" for="slideWaiting" prop="stop"></blam-blam>
        </section>

        <section data-speech="sick beat, babes" data-pause="4" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <bands-blam 
                id="basicVis" 
                fps="9"
                analyser="#bossAnalyser" 
                class="u-squiggle"
                style="inline-size: 75vw; max-block-size: 80%"
                count="8"
              >
              </bands-blam>
            </div>
            <div class="l-frame u-blend" style="justify-content: space-between">
              <dial-blam to="#snare" prop="detune" style="font-size: 0.8em">
                <label style="padding: 1em">
                  tune snare
                  <input type="range" min="-500" max="500" step="10">
                </label>
              </dial-blam>
              <dial-blam to="#kick" prop="detune" style="font-size: 0.8em">
                <label style="padding: 1em">
                  tune kicks
                  <input type="range" min="-500" max="500" step="10">
                </label>
              </dial-blam>
            </div>
          </div>
          <blam-blam to="#basicVis" for="slideNext" prop="start"></blam-blam>
          <blam-blam to="#cowbellTrack" for="slideNext" prop="solo" value="false"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="true"></blam-blam>
          <blam-blam to="#beat" for="slideNext" prop="play"></blam-blam>
          <blam-blam to="#crush" for="slideWaiting" prop="bypass" value="false"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/illustrations/humanization3.svg" alt="diagram demonstrating swing by bunching beats together">
            </div>
          </div>
          <blam-blam to="#basicVis" for="slideNext" prop="stop"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam to="#crush" for="slideNext" prop="bypass" value="true"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
<pre><code>odd ? time : time + (quarterBeat * swing)</code></pre>
            </div>
          </div>
          <blam-blam to="#beat" for="slideWaiting" prop="stop"></blam-blam>
        </section>

        <section>
          <div class="l-screen">
            <media-blam out="garbleBus">
              <video hidden class="u-contrast" id="dancer" onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/dancer.mp4" loop></video>
            </media-blam>
            <div class="l-frame u-blend">
              <switch-blam id="swingSwitch" to="#beat" prop="swing" value="0.15" style="font-size: 1.5em">
                <label>
                  swing 
                  <input type="checkbox">
                </label>
              </switch-blam>
<pre><code>&lt;sequencer-blam <span class="u-hl">swing="<display-blam from="#beat" prop="swing" places="2"></display-blam>"</span>>
  &lt;track-blam>...&lt;/track-blam>
  &lt;track-blam>...&lt;/track-blam>
  &lt;track-blam>...&lt;/track-blam>
&lt;sequencer-blam></code></pre>
            </div>
          </div>
          <blam-blam from="#swingSwitch" to="#dancer" prop="hidden"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="true"></blam-blam>
          <blam-blam to="#beat" for="slideNext" prop="play"></blam-blam>
          <blam-blam to="#crush" for="slideWaiting" prop="bypass" value="false"></blam-blam>
        </section>

        <section class="u-rip" id="#hiHat" data-speech="Hi, hat. How are you doing?" data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <svg id="hiHatSketch" style="max-block-size: 80%" xmlns="http://www.w3.org/2000/svg" xml:space="preserve" viewBox="0 0 1000 792"><path fill="#f9f9f9" d="M502 0c-6 0-14 9-17 19-2 9-2 19-2 105a30652 30652 0 0 1-2 667l18 1c18 0 18-1 20-2 3-3 3-6 4-17l-1-20c-2-10-2-13-2-40l-1-58v-67l1-124a904 904 0 0 0 2-105v-80a2257 2257 0 0 1 0-213l-2-20c-1-27-3-34-8-40q-5-6-10-6m0 7h2q4 2 7 7l3 26 3 35a2271 2271 0 0 0 0 232v51l-1 55-1 51-1 77a2667 2667 0 0 0 2 211c2 15 1 30 0 32l-16 2-15-1a1474 1474 0 0 0 2-124V463l1-392c1-33 1-43 3-50 1-4 5-11 8-13z"/><path d="M460 677c20 13 36 30 80 0l40-40 420-100c-399 43-706 26-1000 0l420 100z"/><g class="hat-top"><path d="M460 383h80l40 40 420 100Q501 564 0 523l420-100z"/><path fill="#f9f9f9" d="m497 381-39 1-25 25-12 11c-6 5-6 5-34 11l-64 15-12 2a1910 1910 0 0 1-162 39l-38 9a541 541 0 0 0-71 13c-20 4-26 6-31 9q-4 3-3 6c1 4 6 5 30 6l48 5 32 2 20 1 25 1 22 1 23 1a505 505 0 0 1 86 5l26 2c15 1 35 2 52 1h31l42 1 176 2c32 0 34 0 58-4l43-2c29 0 35-1 44-2 10-1 13-2 34-2l33 2c10 1 26 1 37-1 36-6 38-7 82-8 30-1 36-1 40-4q4-3 3-7c-1-3-7-5-26-9l-47-12-74-18-43-10c-21-7-30-9-61-13l-24-5a664 664 0 0 0-98-24l-41-14c-8-6-23-18-29-25-7-8-9-10-14-11zm3 5h36l2 2 8 8c7 7 20 19 28 24a298 298 0 0 0 94 27 260 260 0 0 1 55 15l14 2q30 2 66 14c15 5 25 7 41 10l21 5 119 30 2 1-2 1-47 3c-28 1-35 1-50 4a189 189 0 0 1-55 4l-29-1c-22-1-24-1-40 2l-44 2c-34 0-34 0-47 2a322 322 0 0 1-83 3l-187-2-28-1c-14 2-39 1-52-1l-29-1-31-2c-17-2-29-3-49-3l-27-1-29-2-38-1a381 381 0 0 1-60-6l-43-3h-2l2-2 27-6 34-8a601 601 0 0 0 77-16 458 458 0 0 1 63-13l15-4a348 348 0 0 1 59-14 707 707 0 0 1 76-18l41-9 10-3 5-4 39-37zm57 82-58 5-34-2h-29l7 1 42 3a599 599 0 0 0 72-5q3-2 0-2m-77 22 10 1zm-208 6h-12l9 1 19 1 42 1q2-2-18-2l-21-1zm492 8h-3l-60 5q-1 1 1 1a156 156 0 0 0 39-2l24-4zm-540 7-3 1 7 1 26 5q9 2 39 4l24 1-26-3-36-4zm562 3q-6-1-19 1a707 707 0 0 1-111 4l1 1 124-4 6-2z"/></g><path fill="#f9f9f9" d="M6 531v2q-1 2 4 6 3 4 10 5 22 7 51 11l31 7 18 5h16l16 1 8 3 40 12 23 7a296 296 0 0 