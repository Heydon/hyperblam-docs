            </div>
          </div>
          <blam-blam to="#freqs" prop="stop" for="slideNext"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/frame-rate.svg" alt="frame rate and interpolation">              
