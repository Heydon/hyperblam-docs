<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Making HTML Make Music</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="{{site.basedir}}/static/css/fonts.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{site.basedircdn}}/static/css/fonts.css"></noscript>
    <link rel="preload" href="{{site.basedir}}/static/css/slides.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{site.basedir}}/static/css/slides.css"></noscript>
    <link rel="icon" type="image/svg+xml" href="{{site.basedir}}/static/images/favicon.svg" sizes="any">
    <style>
      :root{--color-fore:#fff;--color-back:#000;color:var(--color-fore);background-color:var(--color-back);line-height:1.5}.l-flow>*+*{margin-block-start:var(--s-l)}.l-flow>p:not(:has(img))+p:not(:has(img)){margin-block-start:var(--s-s)}.l-view{min-block-size:100dvh;display:flex;flex-direction:column;margin:0}.l-view main{margin:var(--s-m) var(--s-s)}.l-skip:not(:focus-visible){transform:translateY(-200%)}.l-skip{outline:0;display:block;position:absolute;z-index:200;inset:0 0 auto 0;text-align:center;padding:var(--s-s);color:var(--color-back);background-color:var(--color-fore)}
    </style>
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" version="1.1" style="block-size: 0; overflow: hidden; position: absolute;">
      <defs>
        <filter id="warp-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.009" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.005" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.007" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-4" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.004" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="noise-big-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.006" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" />
        </filter>
        <filter id="noise-big-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.008" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="15" />
        </filter>
        <filter id="noise-big-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.004" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="20" />
        </filter>
        <filter id="noise-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.02" numOctaves="1" result="noise" seed="2"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" />
        </filter>
        <filter id="noise-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.01" numOctaves="1" result="noise" seed="3"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" />
        </filter>
        <filter id="noise-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.002" numOctaves="1" result="noise" seed="4"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" />
        </filter>
        <filter id="distort-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.001 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="90"/>
        </filter>
        <filter id="distort-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.009 0.3" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="110"/>
        </filter>
        <filter id="distort-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.003 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="200"/>
        </filter>
        <filter id="distort-4" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.007 0.2" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="100"/>
        </filter>
        <filter id="distort-5" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.001 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="70"/>
        </filter>
      </defs>
    </svg>
    <audio-blam>
      <div>
        <section>
          <div class="l-screen">
            <div class="l-frame">
              <h1 class="u-squiggle">Making HTML<br>Make Music</h1>
              <p class="u-tilt">with <strong>Heydon</strong> &amp; <strong>Moira</strong></p>
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/intro_masked.mp4"></video>
          </media-blam>
        </section>

        <section data-speech="an HTML cowbell button, with a single sample bank" data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <tap-blam to="#cowbell" prop="play" value="1">
                <button>cowbell</button>
              </tap-blam>
<pre><code>&lt;bank-blam>
  &lt;sample-blam src="<span class="u-hl">cowbell-01.mp3</span>">&lt;/sample-blam>
&lt;/bank-blam> </code></pre>
            </div>
          </div>
        </section>

        <section data-speech="another HTML cowbell button, this time with multiple samples." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <tap-blam to="#cowbell" prop="play">
                <button>cowbell</button>
              </tap-blam>
<pre><code>&lt;bank-blam>
  &lt;sample-blam src="<span class="u-hl">cowbell-01.mp3</span>">&lt;/sample-blam>
  &lt;sample-blam src="<span class="u-hl">cowbell-02.mp3</span>">&lt;/sample-blam>
  &lt;sample-blam src="<span class="u-hl">cowbell-03.mp3</span>">&lt;/sample-blam>
  &lt;sample-blam src="<span class="u-hl">cowbell-04.mp3</span>">&lt;/sample-blam>
&lt;/bank-blam> </code></pre>
            </div>
          </div>
        </section>

        <section id="lengthSlide" data-speech="another fecking HTML cowbell button, now with a blam blam element." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <tap-blam to="#cowbell" prop="play">
                <button>cowbell</button>
              </tap-blam>
<pre><code>&lt;blam-blam prop="length" value="0.01|0.02|1|1">&lt;/blam-blam></code></pre>
            </div>
          </div>
          <blam-blam to="#cowLength" prop="bypass" event="slideNext" once></blam-blam>
        </section>

        <section data-speech="A toy drum machine. For children." data-voice="Moira" data-pause="1">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/drum_machine.svg" alt="drum machine with a single drum pad highlighted.">
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/too_slow.mp4"></video>
          </media-blam>
        </section>

        <section id="trackSlide" data-speech="An HTML range input with the label “more cowbell” associated with a track element with a chance property." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <dial-blam to="#cowbellTrack" prop="chance">
                <label>
                  more cowbell
                  <input type="range" min="0.0" max="1.0" step="any">
                </label>
              </dial-blam>
<pre><code>&lt;sequencer-blam>
  &lt;track-blam <span class="u-hl">chance="<display-blam from="#cowbellTrack" prop="chance" places="2"></display-blam>"</span>>
    &lt;bar-blam s="?">&lt;/bar-blam>
  &lt;/track-blam>
&lt;sequencer-blam></code></pre>
            </div>
          </div>
          <blam-blam to="#cowbells" prop="play" event="slideNext" once></blam-blam>
        </section>

        <section data-speech="A more. more. cowbell range input" data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <dial-blam to="audio-blam" prop="bpm">
                <label>
                  more more<br>cowbell
                  <input id="moremoreInput" type="range" min="90" max="200" step="1">
                </label>
              </dial-blam>
<pre><code>&lt;audio-blam bpm="<span class="u-hl"><display-blam from="audio-blam" prop="bpm"></display-blam></span>"
  &lt;sequencer-blam>
    &lt;track-blam chance="<display-blam from="#cowbellTrack" prop="chance" places="2"></display-blam>"</span>>
      &lt;bar-blam s="?">&lt;/bar-blam>
    &lt;/track-blam>
  &lt;sequencer-blam>
&lt/audio-blam></code></pre>
            </div>
          </div>
          <blam-blam to="#cowbellTrack" prop="chance" value="0.7" event="slideNext" once></blam-blam>
          <blam-blam to="#cowbells" prop="stop" event="slideNext" once></blam-blam>
          <blam-blam to="#cowbells" prop="stop" event="slideNext" once></blam-blam>
          <blam-blam from="#moremoreInput" to="#cowbells" prop="play" event="focus" once></blam-blam>
        </section>

        <section id="reverseDiagram">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/reverse_sample.svg" alt="A sample waveform and the same waveform reversed using Array dot prototype dot reverse.">
            </div>
          </div>
          <blam-blam to="#cowbells" prop="playStop" event="slideNext" once></blam-blam>
        </section>

        <section data-speech="A reverse cowgirl range input." data-pause="1" data-voice="Moira">
          <div class="l-screen">
            <div class="l-frame">
              <dial-blam to="#cowbell" prop="reverse">
                <label>
                  reverse cowgirl
                  <input id="reverseInput" type="range" min="0" max="1" step="0.01">
                </label>
              </dial-blam>
<pre><code>&lt;pads-blam reverse="<span class="u-hl"><display-blam from="#cowbell" prop="reverse" places="2"></display-blam></span>">...&lt;/pads-blam></code></pre>
            </div>
          </div>
          <blam-blam to="#cowLength" prop="bypass" event="slideNext" once></blam-blam>
          <blam-blam to="#cowbell" prop="length" value="1" event="slideNext" once></blam-blam>
          <blam-blam to="#cowbellTrack" prop="chance" value="0.5" event="slideNext" once></blam-blam>
          <blam-blam to="#cowbell" prop="choke" value="false" event="slideNext" once></blam-blam>
          <blam-blam from="#reverseInput" to="#cowbells" prop="playStop" event="focus" once></blam-blam>
        </section>

        <section data-speech="A blam blam element controlling the detune parameter." data-voice="Moira" data-pause="1">
          <div class="l-screen">
            <div class="l-frame">
<pre style="font-size: 1.125em"><code>&lt;blam-blam 
  prop="detune" 
  value="0|400|-1200|-800|-600|-500"
>&lt;/blam-blam></code></pre>                
            </div>
          </div>
          <blam-blam to="#cowbells" prop="stop" event="slideNext" once></blam-blam>
        </section>

        <section class="u-no-stab" data-speech="A signal chain." data-voice="Moira" data-pause="1">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/signal_chain.svg" alt="a signal chain starting with an input and ending with an output. Along the way are echo and reverb effects.">              
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <pre></code>&lt;chain-blam out="bus">
  &lt;echo-blam beats="1.5" feeback="0.5">&lt;/echo-blam>
  &lt;reverb-blam>
    &lt;sample-blam mix="0.5" src="/IR.mp3">&lt;/sample-blam>
  &lt;/reverb-blam>
&lt;/chain-blam></code></pre>                     
            </div>
          </div>
        </section>

        <section class="u-no-stab" data-speech="A guitar effect or stomp box." data-voice="Moira" data-pause="1">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/stomp_box.svg" alt="a stomp box with rate and feedback dials">               
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.6" src="{{site.basedir}}/static/video/okay_dont_tell_me.mp4"></video>
          </media-blam>
        </section>

        <section>
          <div class="l-screen">
            <div class="l-frame">
              <dial-blam to="#cowEcho" prop="feedback">
                <label>
                  echo feedback
                  <input type="range" min="0.1" max="0.9" step="any"></input>
                </label>
              </dial-blam>
              <dial-blam to="#cowVerb" prop="mix">
                <label>
                  reverb mix
                  <input type="range" min="0.1" max="1" step="any"></input>
                </label>
              </dial-blam>
              <pre></code>&lt;chain-blam>
  &lt;echo-blam beats="1.5" <span class="u-hl">feeback="<display-blam from="#cowEcho" prop="feedback" places="2"></display-blam>"</span>>&lt;/echo-blam>
  &lt;reverb-blam>
    &lt;sample-blam <span class="u-hl">mix="<display-blam from="#cowVerb" prop="mix" places="2"></display-blam>"</span> src="/IR.mp3">&lt;/sample-blam>
  &lt;/reverb-blam>
&lt;/chain-blam></code></pre>
            </div>
          </div>
          <blam-blam to="#cowbellsAmb" prop="playStop" event="slideNext" once></blam-blam>
          <blam-blam to="audio-blam" prop="bpm" value="60" event="slideNext" once></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <rings-blam 
                class="u-squiggle"
                analyser="#reverseAnal"
                id="cowAmbData"
                fps="12"
                ratio="1/1"
                style="inline-size: 100%"
              >
              </rings-blam>
            </div>
            <div class="l-frame">
              <log-blam from="#cowAmbData" style="white-space: pre; font-size: 0.6em">[[css]]</log-blam>
            </div>
          </div>
          <blam-blam to="#cowAmbData" prop="start" event="slideNext" once></blam-blam>
          <blam-blam to="#reverseGain" prop="gain" value="0" ramp="24" event="slideNext" once></blam-blam>
          <blam-blam to="#cowbellsAmb" prop="playStop" event="slideNext" once></blam-blam>
        </section>  

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
<pre style="font-size: 0.6em"><code>&lt;g style="--cow-freq: var(--cow-freq-1)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-2)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-3)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-4)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-5)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-6)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-7)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-8)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-9)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-10)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-11)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-12)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-13)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-14)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-15)">&lt;/g>
&lt;g style="--cow-freq: var(--cow-freq-16)">&lt;/g></code></pre>              
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
<pre><code>.cow-stick {
  transform: translateY(calc((1 - var(--cow-freq)) * 65%));
  <span class="u-hl">transition: transform var(--cow-interval)</span>;
}</code></pre>              
            </div>
          </div>
        </section>
        
        <section id="cowSticks">
          <div class="l-screen">
            <div class="l-frame" style="--gap: 2.25em"> 
              <props-blam 
                selector=".cow-stick"
                analyser="#cowbellAnal"
                id="cowData"
                fps="9"
                style="display: contents"
