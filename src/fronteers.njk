              <div class="l-cluster">
                <tap-blam to="#bassNormal" prop="play" value="E2">
                  <button>normal</button>
                </tap-blam>
                <tap-blam to="#bassSlide" prop="play" value="E2">
                  <button>slide</button>
                </tap-blam>
              </div>
            </div>
          </div>
          <blam-blam from="#bassSlide" prop="class" value="u-slide" to=".bass-hand"></blam-blam>
          <blam-blam from="#bassNormal, #bassSlide" prop="class" value="u-jolt-small" to="#bassDrawing"></blam-blam>
        </section>

        <section id="envDiagram" class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/envelope2.svg" alt="diagram of envelope curve">
            </div>
          </div>
        </section>

        <section id="bassBitsSlide" class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
<pre style="font-size: 0.6em"><code>&lt;note-blam id="bass" bank="bassBank" choke notes="E2 E2 G2 A2 A#2 E3">
  &lt;blam-blam prop="length" value="0.25|0.5|0.125">&lt;/blam-blam>
  &lt;chain-blam out="bus">
    &lt;filter-blam freq="8000" q="10">
      &lt;envelope-blam prop="freq" curve="200 0, 11000 0.25">&lt;/envelope-blam>
    &lt;/filter-blam>
  &lt;/chain-blam>
  &lt;envelope-blam prop="detune" curve="-300 0, 0 0.2" chance="0.2">&lt;/envelope-blam>
&lt;/note-blam>

...

&lt;track-blam id="bassTrack" to="#bass">
  &lt;bar-blam s="0 0 0 E3">&lt;/bar-blam>
  &lt;bar-blam s="? ? ? ?" chance="0.6">&lt;/bar-blam>
&lt;/track-blam></code></pre>
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <media-blam out="garbleBus">
              <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/creative_drums_1.mp4"></video>
            </media-blam>
          </div>
          <blam-blam to="#bassTrack" for="slideWaiting" prop="suspend" value="false"></blam-blam>
          <blam-blam to="#beat" for="slideWaiting" prop="stop"></blam-blam>
        </section> 

        <section id="organGhost">
          <div id="babyBass" class="l-screen u-contrast">
            <media-blam out="garbleBus">
              <video id="babyBassVid" style="transform: scale(1.5)" src="{{site.basedir}}/static/video/baby.mp4" loop></video>
            </media-blam>
          </div>
          <div class="l-frame l-cluster u-blend" style="justify-content: space-around">
            <switch-blam to="#organTrack" prop="suspend" style="font-size: 0.6em" reverse>
              <label>
                organ<br>chords
                <input type="checkbox">
              </label>
            </switch-blam>
            <switch-blam to="#snareGhostTrack, #hatTrack" prop="suspend" style="font-size: 0.6em" reverse>
              <label>
                ghost<br>snare
                <input type="checkbox">
              </label>
            </switch-blam>
            <switch-blam to="#bassTrack" prop="part" value=".deep" style="font-size: 0.5em">
              <label>
                deep
                <input type="checkbox">
              </label>
            </switch-blam>
          </div>
          <blam-blam from="#snare" to="#babyBassVid" prop="class" value="u-punch"></blam-blam>
          <blam-blam from="#organ" to="#babyBass" prop="class" value="u-squiggle-1"></blam-blam>
          <blam-blam to=".rhodesTrack" prop="solo" value="false" for="slideNext"></blam-blam>
          <blam-blam to="#cowbellTrack" prop="chance" value="0" for="slideNext"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="true"></blam-blam>
          <blam-blam to="#beat" for="slideNext" prop="play"></blam-blam>
        </section>

<!-- visualizations -->
        <section class="u-no-stab">
          <div class="l-screen">
            <freqs-blam 
              analyser="#bossAnalyser"
              id="freqs"
              fps="8"
              ratio="1/1"
            >
            </freqs-blam>
            <div class="l-frame">
              <log-blam from="#freqs" style="white-space: pre; font-size: 0.6em">[[css]]</log-blam>
            </div>
          </div>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam to="#freqs" prop="start" for="slideNext"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
