---
title: Not a Farfisa But A Nearfisa
bpm: 70
elements: 
  - Synth 
  - carrier
---

{% extends 'layouts/example-synth.njk' %}

{% block audio %}
<chain-blam id="bus">
  <reverb-blam cutoff="1000">
    <sample-blam src="{{site.basedir}}/static/sounds/IRs/spring.mp3"></sample-blam>
  </reverb-blam>
  <limiter-blam></limiter-blam>
  <analyser-blam id="analyser"></analyser-blam>
</chain-blam>

<!-- percussion
<synth-blam notes="C7 D#7 G7">
  <carrier-blam out="bus" curve="1 0.01, 0 0.125" release="0.01" type="sawtooth" feedback="3179">
  </carrier-blam>  
</synth-blam> -->

<synth-blam id="nearfisa" notes="C5 D#5 G5">
  <carrier-blam out="bus" curve="1 0.01, 0.8 0.25" release="0.01" type="triangle">
  </carrier-blam>
  <carrier-blam out="bus" gain="0.75" curve="1 0.01, 0.8 0.25" release="0.01" type="triangle" offset="12">
  </carrier-blam>
  <carrier-blam out="bus" gain="1" curve="1 0.01, 0.8 0.25" release="0.01" type="triangle" offset="24">
  </carrier-blam>
  <lfo-blam prop="detune" gain="50" beats="0.2" type="triangle"></lfo-blam>
  <lfo-blam prop="detune" gain="25" beats="2.3" type="triangle"></lfo-blam>
</synth-blam>

<sequencer-blam>
  <track-blam to="#nearfisa">
    <bar-blam s="C5 0 G5 0 F5 0 G5 0 D#5 0 F5 0 D5 0 D#5 0"></bar-blam>
  </track-blam>
</sequencer-blam>

<tap-blam to="sequencer-blam" prop="playStop">
  <button aria-pressed="false" class="u-round" aria-label="play">{% icon 'playStop' %}</button>
</tap-blam>
{% endblock %}

{% block dialog %}

{% renderTemplate "md" %}

{% endrenderTemplate %}

{% endblock %}

{% block controls %}
<kbd-blam to="#nearfisa" prop="play" key="1"></kbd-blam>
{% endblock %}