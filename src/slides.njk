            </div>
          </div>
          <blam-blam to="#beat" for="slideNext" prop="stop"></blam-blam>
          <kbd-blam id="closedHatKey" key="1" to="#hat" prop="play" value="1|2|3">
            <blam-blam to=".hat-top" prop="--hatHeight" value="1%"></blam-blam>
          </kbd-blam>
          <kbd-blam id="openHatKey" key="2" to="#hat" prop="play" value="4">
            <blam-blam to=".hat-top" prop="--hatHeight" value="-27%"></blam-blam>
          </kbd-blam>
          <blam-blam from="#hat" to="#hiHatSketch" prop="class" value="u-jolt"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/choke1.svg" alt="sounds left to ring out versus sounds choked (foreshortened)">
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/choke2.svg" alt="sounds left to ring out versus sounds choked with 0.05 second ramp">
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/hat_tracks.svg" alt="showing the two separate hat tracks: one for the closed hat with 10 quarter beats and one for the open hat with just one beat but a low probability">
            </div>
          </div>
          <blam-blam to=".hatTrack" for="slideNext" prop="suspend" value="false"></blam-blam>
          <blam-blam to=".hatTrack" for="slideNext" prop="solo" value="true"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam to="#beat" for="slideNext" prop="play"></blam-blam>
        </section>

        <section class="u-no-stab">
          <media-blam out="garbleBus">
            <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/one_second.mp4"></video>
          </media-blam>
        </section>

        <section>
          <div class="l-screen">
            <media-blam out="garbleBus">
              <video class="u-contrast" id="dancer" onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/dancer.mp4" loop></video>
            </media-blam>
            <div class="l-frame u-blend">

            </div>
          </div>
          <blam-blam to=".hatTrack" for="slideNext" prop="solo" value="false"></blam-blam>
          <blam-blam to="#cowbellTrack" for="slideNext" prop="chance" value="0.4"></blam-blam>
          <blam-blam from="#snare" to="#dancer" prop="class" value="u-punch"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="true"></blam-blam>
        </section>

        <section id="clockSlide" class="u-no-stab" id="spinner">
          <div class="l-screen"> 
            <img style="height: 90%" class="u-spin" src="{{site.basedir}}/static/images/slides/spinner.svg" alt="loading spinner">
            <div class="l-frame">
              <dial-blam to="audio-blam" prop="bpm" style="font-size: 0.75em">
                <label>
                  bpm
                  <input type="range" min="0" max="240">
                </label>
              </dial-blam>
            </div> 
          </div>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam to="#clockTrack" for="slideNext" prop="suspend" value="false"></blam-blam>
          <blam-blam to="#clockCustomProps" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam id="clockCustomProps" from="#clock" prop="--spinnerDegs" to="" value="0deg|45deg|90deg|135deg|180deg|225deg|270deg" robin bypass></blam-blam>
        </section>
      </div>

<!-- buses -->
      <chain-blam id="bossBus">
        <analyser-blam id="bossAnalyser"></analyser-blam>
      </chain-blam>

      <chain-blam id="garbleBus" out="bossBus">
        <saturator-blam id="garble" mode="4" amount="71" mix="1" lowcut="500" highcut="8000" bypass></saturator-blam>
      </chain-blam>

      <chain-blam id="crushBus" out="bossBuss">
        <gain-blam id="crushGain" gain="0.35" bypass>
          <lfo-blam type="square" beats="0.009" gain="0.35">
            <blam-blam from="#cowbell" prop="beats" value="0.005~0.01" chance="0.6"></blam-blam>
          </lfo-blam>
        </gain-blam>
      </chain-blam>

      <chain-blam id="subdueBus" bypass out="bossBus">
        <filter-blam type="highpass" freq="800"></filter-blam>
        <filter-blam type="lowpass" freq="3000"></filter-blam>
        <gain-blam gain="0.4"></gain-blam>
        <reverb-blam mix="0.25" cutoff="400">
          <sample-blam src="{{site.basedir}}/static/sounds/IRs/room-medium.mp3"></sample-blam>
        </reverb-blam>
      </chain-blam>

<!-- instruments -->
      <pad-blam id="stabs" gain="0.6" bank="stabBank">
        <blam-blam from="section:not(.u-no-stab, .u-rip)" prop="play" for="slideNext"></blam-blam>
      </pad-blam>

      <pad-blam id="rip" gain="0.25" bank="ripBank" detune="600">
        <blam-blam from="section.u-rip" prop="play" for="slideNext"></blam-blam>
      </pad-blam>

      <pad-blam id="radio" gain="0.07" detune="0" loop>
        <bank-blam>
          <sample-blam src="{{site.basedir}}/static/sounds/slides/radio.mp3" reverse></sample-blam>
        </bank-blam>
        <lfo-blam id="radioSpeed" prop="detune" gain="800" beats="3" type="square">
          <blam-blam from="body" prop="beats" value="0.01~0.5" for="slideWaiting"></blam-blam>
          <lfo-blam prop="gain" gain="800" beats="9.1"></lfo-blam>
        </lfo-blam>
        <blam-blam from="body" prop="detune" value="0~4000" for="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="length" value="1~3" for="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="play" for="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="stop" for="slideChange"></blam-blam>
        <blam-blam from="body" to="#garble" prop="bypass" value="false" for="slideWaiting"></blam-blam>
        <blam-blam from="body" to="#garble" prop="bypass" value="true" for="slideChange"></blam-blam>
        <blam-blam from="body" to="#crushGain" prop="bypass" for="slideWaiting"></blam-blam>
        <blam-blam from="body" to="#crushGain" prop="bypass" for="slideChange"></blam-blam>
      </pad-blam>

      <pad-blam id="kick" bank="kickBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="kickGhost" bank="kickBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="hat" bank="hatBank" choke gain="1.5">
        <chain-blam out="subdueBus">
          <pan-blam pan="-0.5"></pan-blam>
        </chain-blam>
        <blam-blam prop="detune" value="-25~25"></blam-blam>
      </pad-blam>

      <pad-blam id="snare" bank="snareBank" out="subdueBus" gain="1.5">
      </pad-blam>

      <pad-blam id="snareGhost" bank="snareBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="ride" bank="rideBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="cowbell" bank="cowBank" choke="0.05" out="subdueBus" gain="0.5"> 
        <blam-blam id="cowLength" prop="length" value="0.01|0.02|1|1" bypass></blam-blam>  
      </pad-blam>

      <pad-blam id="clock" bank="clockBank">
        <chain-blam>
          <reverb-blam mix="0.25" cutoff="500">
            <sample-blam src="{{site.basedir}}/static/sounds/IRs/stadium.mp3"></sample-blam>
          </reverb-blam>
        </chain-blam>
      </pad-blam>

<!-- sequencers -->
      <sequencer-blam id="beat" swing="0">
        <track-blam id="kickTrack" to="#kick" part=".basic">
          <part-blam class="basic">
            <bar-blam s="1 0 0 0 0 0 0 4"></bar-blam>
            <bar-blam s="2 0 0 0 0 4 0 3"></bar-blam>
          </part-blam>
        </track-blam>

        <track-blam class="hatTrack" id="hatClosedTrack" to="#hat" part=".basic" chance="0.9" suspend>
          <part-blam class="basic">
            <bar-blam s="1 0 2 0 3 2 1 0 3 0"></bar-blam>
          </part-blam>         
        </track-blam>

        <track-blam class="hatTrack" id="hatOpenTrack" to="#hat" part=".basic" chance="0.1" suspend override="hatClosedTrack">
          <part-blam class="basic">
            <bar-blam s="4"></bar-blam>
          </part-blam>         
        </track-blam>

        <track-blam id="snareTrack" to="#snare" part=".basic">
          <part-blam class="basic">
            <bar-blam s="0 0 0 0 ? 0 0 0"></bar-blam>
          </part-blam>        
        </track-blam>

        <track-blam id="rideTrack" to="#ride" suspend>
          <bar-blam s="? ? ? ? ? ? ? ?"></bar-blam>
        </track-blam>

        <track-blam id="cowbellTrack" to="#cowbell" solo chance="0.0">
          <bar-blam s="?"></bar-blam>
        </track-blam>

        <track-blam id="clockTrack" to="#clock" suspend>
          <bar-blam s="? 0 0 0 ? 0 0 0"></bar-blam>
        </track-blam>
      </sequencer-blam>

<!-- banks -->
      <bank-blam id="stabBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-03.mp3"></sample-blam>
      </bank-blam>

      <bank-blam id="ripBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rip.mp3"></sample-blam>
      </bank-blam>

      <bank-blam id="cowBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-01.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-02.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-03.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-04.mp3" reverse></sample-blam>
      </bank-blam>

      <bank-blam id="rhodesBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-01.mp3" root="E3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-02.mp3" root="E3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-03.mp3" root="E3"></sample-blam>
      </bank-blam>   

      <bank-blam id="kickBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-ghost-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-ghost-02.mp3"></sample-blam>
      </bank-blam> 

      <bank-blam id="hatBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-03.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-04.mp3"></sample-blam>
      </bank-blam> 

      <bank-blam id="snareBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-03.mp3"></sample-blam>
      </bank-blam> 

      <bank-blam id="snareGhostBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-ghost-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-ghost-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-ghost-03.mp3"></sample-blam>
      </bank-blam>

      <bank-blam id="rideBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-03.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-04.mp3"></sample-blam>
      </bank-blam>

      <bank-blam id="clockBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/tick.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/tock.mp3"></sample-blam>
      </bank-blam>
    </audio-blam>

    <script type="module">
      import { random } from '{{ site.basedir }}/static/hyperblam/src/tools/random.js';

      const utter = elem => {
        let text = elem.dataset.speech;
        let voiceData = elem.dataset.voice;
        let pause = elem.dataset.pause;
        let voice;
        if (voiceData) {
          voice = window.voices.find(v => v.name === voiceData);
        } else {
          voice = random.oneOf(window.voices);
        }
        let utterance = new SpeechSynthesisUtterance(text);
        utterance.voice = voice;
        utterance.volume = 0.6;
        window.speechTimeout = window.setTimeout(() => {
          speech.speak(utterance);
        }, pause ? parseInt(pause) * 1000 : 0);
      };

      const narrated = [...document.querySelectorAll('[data-speech]:not(section)')];
      narrated.forEach(elem => {
        elem.addEventListener('mouseover', () => {
          let text = elem.dataset.speech;
          utter(elem);
        });
      });

      window.speech = window.speechSynthesis;
      speech.addEventListener('voiceschanged', () => {
        window.voices = speech.getVoices().filter(voice => ['en-IE', 'en-GB'].includes(voice.lang) && voice.localService);
      });

      const fire = (name, data, target = window, bubbles = false) => {
        let event = new CustomEvent(name, {
          detail: data,
          bubbles: bubbles
        });

        target.dispatchEvent(event);
      }

      const slides = [...document.querySelectorAll('section')];
      const videos = [...document.querySelectorAll('video')];

      slides.forEach((s, i) => {
        s.hidden = true;
      });

      const slideEvents = (oldSlide, newSlide) => {
        fire('slideChange', {}, document.body);
        oldSlide && fire('slidePrev', {}, oldSlide);
        fire('slideNext', {}, newSlide);
      }
      
      window.addEventListener('blamready', () => {
        let startSlide;
        if (window.location.hash) {
          startSlide = slides.find(s => {
            return s.id && window.location.hash.includes(s.id);
          });
        } else {
          startSlide = slides[0];
        }
        startSlide.hidden = false;
        slideEvents(null, startSlide);

        document.addEventListener('keydown', e => {
          let thisSlide = document.querySelector('section:not([hidden])');
          if (!event.key.includes('Arrow')) {
            return;
          }
          if (document.activeElement.tagName === 'INPUT') {
            return;
          }
          let back = ['Up', 'Left'].some(key => e.key.includes(key));
          let newDir = back ? 'previous' : 'next';
          let newSlide = thisSlide[`${newDir}ElementSibling`];
          if (!newSlide) {
            return;
          }
          if (!window.waiting) {
            window.speech.cancel();
            thisSlide.classList.add('u-wait');
            window.waiting = true;
            window.lastKey = e.key;
            fire('slideWaiting', {}, thisSlide);
            fire('slideWaiting', {}, document.body);
            return;
          }
          if (window.lastKey !== e.key) {
            return;  
          }
          slides.forEach(slide => slide.hidden = true);
          clearTimeout(window.speechTimeout);
          thisSlide.classList.remove('u-wait');
          window.waiting = newSlide.hidden = false;
          if (newSlide.dataset.speech) {
            utter(newSlide);
          }
          videos.forEach(video => {
            video.pause();
            video.currentTime = 0;
          });
          let newVideo = newSlide.querySelector('video');
          newVideo && newVideo.play();

          slideEvents(thisSlide, newSlide);
        });

        videos.forEach(video => {
          video.addEventListener('play', event => {
            event.stopPropagation();
          });
        });
      });
    </script>
    <script type="module" src="{{site.basedir}}/{{site.hyperblampath}}"></script>
  </body>
</html>