<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Making HTML Make Music</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preload" href="{{site.basedir}}/static/css/fonts.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{site.basedircdn}}/static/css/fonts.css"></noscript>
    <link rel="preload" href="{{site.basedir}}/static/css/slides.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{site.basedir}}/static/css/slides.css"></noscript>
    <link rel="icon" type="image/svg+xml" href="{{site.basedir}}/static/images/favicon.svg" sizes="any">
    <style>
      :root{--color-fore:#fff;--color-back:#000;color:var(--color-fore);background-color:var(--color-back);filter: brightness(0.85);line-height:1.5}.l-flow>*+*{margin-block-start:var(--s-l)}.l-flow>p:not(:has(img))+p:not(:has(img)){margin-block-start:var(--s-s)}.l-view{min-block-size:100dvh;display:flex;flex-direction:column;margin:0}.l-view main{margin:var(--s-m) var(--s-s)}.l-skip:not(:focus-visible){transform:translateY(-200%)}.l-skip{outline:0;display:block;position:absolute;z-index:200;inset:0 0 auto 0;text-align:center;padding:var(--s-s);color:var(--color-back);background-color:var(--color-fore)}
    </style>
  </head>
  <body>
    <svg xmlns="http://www.w3.org/2000/svg" version="1.1" style="block-size: 0; overflow: hidden; position: absolute;">
      <defs>
        <filter id="warp-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.009" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.005" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.007" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="warp-4" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence type="turbulence" baseFrequency="0.004" id="turbulence" numOctaves="1" result="turbulence" seed="5"></feTurbulence>
          <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="100" xChannelSelector="R" yChannelSelector="R"></feDisplacementMap>
        </filter>
        <filter id="noise-big-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.006" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" />
        </filter>
        <filter id="noise-big-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.008" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="15" />
        </filter>
        <filter id="noise-big-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.004" numOctaves="1" result="noise" seed="1"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="20" />
        </filter>
        <filter id="noise-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.02" numOctaves="1" result="noise" seed="2"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" />
        </filter>
        <filter id="noise-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.01" numOctaves="1" result="noise" seed="3"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" />
        </filter>
        <filter id="noise-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.002" numOctaves="1" result="noise" seed="4"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" />
        </filter>
        <filter id="distort-1" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.001 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="90"/>
        </filter>
        <filter id="distort-2" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.009 0.3" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="110"/>
        </filter>
        <filter id="distort-3" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.003 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="200"/>
        </filter>
        <filter id="distort-4" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.007 0.2" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="100"/>
        </filter>
        <filter id="distort-5" width="100%" height="100%" x="0%" y="0%">
          <feTurbulence baseFrequency="0.001 0.1" numOctaves="1"/>
          <feDisplacementMap in="SourceGraphic" scale="70"/>
        </filter>
      </defs>
    </svg>
    <audio-blam bpm="90">
      <div>

<!-- slides -->
        <section>
          <div class="l-screen">
            <div class="l-frame">
              <h1 class="u-squiggle">Making HTML<br>Make Music</h1>
              <p class="u-tilt">with <strong>Heydon</strong> &amp; <strong>Moira</strong></p>
            </div>
          </div>
        </section>

        <section>
          <div class="l-screen">
            <div class="l-frame">
              <h1 class="u-squiggle">SLIDE 2</h1>
            </div>
          </div>
          <blam-blam to="#beat" for="slideNext" prop="play"></blam-blam>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <h1 class="u-squiggle">SLIDE 3</h1>
              <p>(subdue beat)</p>
            </div>
          </div>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass"></blam-blam>
        </section>

        <section>
          <div class="l-screen">
            <div class="l-frame">
              <h1 class="u-squiggle">SLIDE 4</h1>
              <p>(renew beat)</p>
            </div>
          </div>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="true"></blam-blam>
        </section>
      </div>

<!-- buses -->
      <chain-blam id="garbleBus" bypass>
        <saturator-blam id="garble" mode="4" amount="71" mix="1" lowcut="500" highcut="8000"></saturator-blam>
        <gain-blam id="garbleGain" gain="3"></gain-blam>
      </chain-blam>

      <chain-blam id="crushBus">
        <gain-blam id="crushGain" gain="0.35" bypass>
          <lfo-blam type="square" beats="0.009" gain="0.35">
            <blam-blam from="#cowbell" prop="beats" value="0.005~0.01" chance="0.6"></blam-blam>
          </lfo-blam>
        </gain-blam>
      </chain-blam>

      <chain-blam id="subdueBus" bypass>
        <filter-blam type="highpass" freq="800"></filter-blam>
        <filter-blam type="lowpass" freq="5000"></filter-blam>
        <gain-blam gain="0.6"></gain-blam>
        <reverb-blam mix="0.25" cutoff="1000">
          <sample-blam src="{{site.basedir}}/static/sounds/IRs/room-medium.mp3"></sample-blam>
        </reverb-blam>
      </chain-blam>

<!-- instruments -->
      <pad-blam id="stabs" gain="0.6" bank="stabBank">
        <blam-blam from="section:not(.u-no-stab)" prop="play" for="slideNext"></blam-blam>
      </pad-blam>

      <pad-blam id="radio" gain="0.07" detune="0" loop>
        <bank-blam>
          <sample-blam src="{{site.basedir}}/static/sounds/slides/radio.mp3" reverse></sample-blam>
        </bank-blam>
        <lfo-blam id="radioSpeed" prop="detune" gain="800" beats="3" type="square">
          <blam-blam from="body" prop="beats" value="0.01~0.5" for="slideWaiting"></blam-blam>
          <lfo-blam prop="gain" gain="800" beats="9.1"></lfo-blam>
        </lfo-blam>
        <blam-blam from="body" prop="detune" value="0~4000" for="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="length" value="1~3" for="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="play" for="slideWaiting"></blam-blam>
        <blam-blam from="body" prop="stop" for="slideChange"></blam-blam>
        <blam-blam from="body" to="#garbleBus" prop="bypass" value="false" for="slideWaiting"></blam-blam>
        <blam-blam from="body" to="#garbleBus" prop="bypass" value="true" for="slideChange"></blam-blam>
        <blam-blam from="body" to="#crushGain" prop="bypass" for="slideWaiting"></blam-blam>
        <blam-blam from="body" to="#crushGain" prop="bypass" for="slideChange"></blam-blam>
      </pad-blam>

      <pad-blam id="kick" bank="kickBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="kickGhost" bank="kickBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="hat" bank="hatBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="snare" bank="snareBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="snareGhost" bank="snareBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="ride" bank="rideBank" out="subdueBus">
      </pad-blam>

      <pad-blam id="cowbell" bank="cowBank" choke="0.05" out="subdueBus"> 
        <blam-blam id="cowLength" prop="length" value="0.01|0.02|1|1" bypass></blam-blam>  
      </pad-blam>

<!-- sequencers -->
      <sequencer-blam id="beat">
        <track-blam id="kickTrack" to="#kick" part=".basic">
          <part-blam class="basic">
            <bar-blam s="1 0 0 0 0 0 0 4"></bar-blam>
            <bar-blam s="1 0 0 4 0 0 0 3"></bar-blam>
          </part-blam>
        </track-blam>

        <track-blam id="hatTrack" to="#hat" part=".basic">
          <part-blam class="basic">
            <bar-blam s="1 0 2 0 3 2 1 0"></bar-blam>
          </part-blam>         
        </track-blam>

        <track-blam id="snareTrack" to="#snare" part=".basic">
          <part-blam class="basic">
            <bar-blam s="0 0 0 0 ? 0 0 0"></bar-blam>
          </part-blam>        
        </track-blam>

        <!--<track-blam id="rideTrack" to="#ride">
        </track-blam>

        <track-blam id="cowbellTrack" to="#cowbell">
        </track-blam>-->
      </sequencer-blam>

<!-- banks -->
      <bank-blam id="stabBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/stab-03.mp3"></sample-blam>
      </bank-blam>

      <bank-blam id="cowBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-01.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-02.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-03.mp3" reverse></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/cow-04.mp3" reverse></sample-blam>
      </bank-blam>

      <bank-blam id="rhodesBank">
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-01.mp3" root="E3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-02.mp3" root="E3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/slides/rhodes-03.mp3" root="E3"></sample-blam>
      </bank-blam>   

      <bank-blam id="kickBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-ghost-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/kick-ghost-02.mp3"></sample-blam>
      </bank-blam> 

      <bank-blam id="hatBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-03.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/hat-04.mp3"></sample-blam>
      </bank-blam> 

      <bank-blam id="snareBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-03.mp3"></sample-blam>
      </bank-blam> 

      <bank-blam id="snareGhostBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-ghost-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-ghost-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/snare-ghost-03.mp3"></sample-blam>
      </bank-blam>

      <bank-blam id="snareGhostBank">
      </bank-blam>

      <bank-blam id="rideBank">
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-01.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-02.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-03.mp3"></sample-blam>
        <sample-blam src="{{site.basedir}}/static/sounds/kit-tight/ride-04.mp3"></sample-blam>
      </bank-blam>
    </audio-blam>

    <script type="module">
      import { random } from '{{ site.basedir }}/static/hyperblam/src/tools/random.js';

      const utter = elem => {
        let text = elem.dataset.speech;
        let voiceData = elem.dataset.voice;
        let pause = elem.dataset.pause;
        let voice;
        if (voiceData) {
          voice = window.voices.find(v => v.name === voiceData);
        } else {
          voice = random.oneOf(window.voices);
        }
        let utterance = new SpeechSynthesisUtterance(text);
        utterance.voice = voice;
        utterance.volume = 0.6;
        window.speechTimeout = window.setTimeout(() => {
          speech.speak(utterance);
        }, pause ? parseInt(pause) * 1000 : 0);
      };

      const narrated = [...document.querySelectorAll('[data-speech]:not(section)')];
      narrated.forEach(elem => {
        elem.addEventListener('mouseover', () => {
          let text = elem.dataset.speech;
          utter(elem);
        });
      });

      window.speech = window.speechSynthesis;
      speech.addEventListener('voiceschanged', () => {
        window.voices = speech.getVoices().filter(voice => ['en-IE', 'en-GB'].includes(voice.lang) && voice.localService);
      });

      const fire = (name, data, target = window, bubbles = false) => {
        let event = new CustomEvent(name, {
          detail: data,
          bubbles: bubbles
        });

        target.dispatchEvent(event);
      }

      const slides = [...document.querySelectorAll('section')];
      const videos = [...document.querySelectorAll('video')];

      slides.forEach((s, i) => {
        s.hidden = true;
      });

      const slideEvents = (oldSlide, newSlide) => {
        fire('slideChange', {}, document.body);
        oldSlide && fire('slidePrev', {}, oldSlide);
        fire('slideNext', {}, newSlide);
      }
      
      window.addEventListener('blamready', () => {
        let startSlide;
        if (window.location.hash) {
          startSlide = slides.find(s => {
            return s.id && window.location.hash.includes(s.id);
          });
        } else {
          startSlide = slides[0];
        }
        startSlide.hidden = false;
        slideEvents(null, startSlide);

        document.addEventListener('keydown', e => {
          let thisSlide = document.querySelector('section:not([hidden])');
          if (!event.key.includes('Arrow')) {
            return;
          }
          if (document.activeElement.tagName === 'INPUT') {
            return;
          }
          let back = ['Up', 'Left'].some(key => e.key.includes(key));
          let newDir = back ? 'previous' : 'next';
          let newSlide = thisSlide[`${newDir}ElementSibling`];
          if (!newSlide) {
            return;
          }
          if (!window.waiting) {
            window.speech.cancel();
            thisSlide.classList.add('u-wait');
            window.waiting = true;
            window.lastKey = e.key;
            fire('slideWaiting', {}, document.body);
            return;
          }
          if (window.lastKey !== e.key) {
            return;  
          }
          slides.forEach(slide => slide.hidden = true);
          clearTimeout(window.speechTimeout);
          thisSlide.classList.remove('u-wait');
          window.waiting = newSlide.hidden = false;
          if (newSlide.dataset.speech) {
            utter(newSlide);
          }
          videos.forEach(video => {
            video.pause();
            video.currentTime = 0;
          });
          let newVideo = newSlide.querySelector('video');
          newVideo && newVideo.play();

          slideEvents(thisSlide, newSlide);
        });

        videos.forEach(video => {
          video.addEventListener('play', event => {
            event.stopPropagation();
          });
        });
      });
    </script>
    <script type="module" src="{{site.basedir}}/{{site.hyperblampath}}"></script>
  </body>
</html>