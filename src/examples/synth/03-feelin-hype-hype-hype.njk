---
title: Feelin’ Hype Hype Hype
bpm: 100
elements: 
  - Synth 
  - carrier
---

{% extends 'layouts/example-synth.njk' %}

{% block audio %}
<chain-blam id="bus">
  <reverb-blam mix="0.2">
    <sample-blam src="{{site.basedir}}/static/sounds/IRs/roland-spring-soft.mp3"></sample-blam>
  </reverb-blam>
  <limiter-blam></limiter-blam>
  <analyser-blam id="analyser"></analyser-blam>
</chain-blam>

<synth-blam notes="C4 D4 E4 G4 A4" out="bus">
  <carrier-blam curve="0 0, 1 0.03, 0 2" release="2">
    <modulator-blam curve="0 0, 1 0.03, 0 1.25" ratio="3" gain="750">
      <blam-blam prop="gain" value="100~3000"></blam-blam>
    </modulator-blam>
  </carrier-blam>
  <carrier-blam curve="0 0, 1 0.02, 0 0.06" release="2" offset="-12">
  </carrier-blam>
</synth-blam>

<tap-blam to="synth-blam" prop="play">
  <button>hit steel drum</button>
</tap-blam>
{% endblock %}

{% block dialog %}

{% renderTemplate "md" %}

{% endrenderTemplate %}

{% endblock %}

{% block controls %}
<dial-blam prop="gain" to="modulator-blam">
  <label>
    mod index
    <input type="range" min="0" max="3000">
  </label>
</dial-blam>
{% endblock %}