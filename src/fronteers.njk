    <script type="module">
      import { random } from '{{ site.basedir }}/static/hyperblam/src/tools/random.js';
      import { Disrupt } from '{{ site.basedir }}/static/js/Disrupt.js';

      customElements.define('disrupt-svg', Disrupt);

      const utter = elem => {
        let text = elem.dataset.speech;
        let voiceData = elem.dataset.voice;
        let pause = elem.dataset.pause;
        let voice;
        if (voiceData) {
          voice = window.voices.find(v => v.name === voiceData);
        } else {
          voice = random.oneOf(window.voices);
        }
        let utterance = new SpeechSynthesisUtterance(text);
        utterance.voice = voice;
        utterance.volume = 0.6;
        window.speechTimeout = window.setTimeout(() => {
          speech.speak(utterance);
        }, pause ? parseInt(pause) * 1000 : 0);
      };

      const narrated = [...document.querySelectorAll('[data-speech]:not(section)')];
      narrated.forEach(elem => {
        elem.addEventListener('mouseover', () => {
          let text = elem.dataset.speech;
          utter(elem);
        });
      });

      window.speech = window.speechSynthesis;
      speech.addEventListener('voiceschanged', () => {
        window.voices = speech.getVoices().filter(voice => ['en-IE', 'en-GB'].includes(voice.lang) && voice.localService);
      });

      const fire = (name, data, target = window, bubbles = false) => {
        let event = new CustomEvent(name, {
          detail: data,
          bubbles: bubbles
        });

        target.dispatchEvent(event);
      }

      const slides = [...document.querySelectorAll('section')];
      const videos = [...document.querySelectorAll('video')];

      slides.forEach((s, i) => {
        s.hidden = true;
      });

      const slideEvents = (oldSlide, newSlide) => {
        fire('slideChange', {}, document.body);
        oldSlide && fire('slidePrev', {}, oldSlide);
        fire('slideNext', {}, newSlide);
      }
      
      window.addEventListener('blamready', () => {
        let startSlide;
        if (window.location.hash) {
          startSlide = slides.find(s => {
            return s.id && window.location.hash.includes(s.id);
          });
        } else {
          startSlide = slides[0];
        }
        startSlide.hidden = false;
        slideEvents(null, startSlide);

        document.addEventListener('keydown', e => {
          let thisSlide = document.querySelector('section:not([hidden])');
          if (!event.key.includes('Arrow')) {
            return;
          }
          if (document.activeElement.tagName === 'INPUT') {
            return;
          }
          let back = ['Up', 'Left'].some(key => e.key.includes(key));
          let newDir = back ? 'previous' : 'next';
          let newSlide = thisSlide[`${newDir}ElementSibling`];
          if (!newSlide) {
            return;
          }
          if (!window.waiting) {
            window.speech.cancel();
            thisSlide.classList.add('u-wait');
            window.waiting = true;
            window.lastKey = e.key;
            fire('slideWaiting', {}, thisSlide);
            fire('slideWaiting', {}, document.body);
            return;
          }
          if (window.lastKey !== e.key) {
            return;  
          }
          slides.forEach(slide => slide.hidden = true);
          clearTimeout(window.speechTimeout);
          thisSlide.classList.remove('u-wait');
          window.waiting = newSlide.hidden = false;
          if (newSlide.dataset.speech) {
            utter(newSlide);
          }
          videos.forEach(video => {
            video.pause();
            video.currentTime = 0;
          });
          let newVideos = [...newSlide.querySelectorAll('video')];
          if (newVideos.length) {
            newVideos.forEach(video => video.play());
          }

          slideEvents(thisSlide, newSlide);
        });

        videos.forEach(video => {
          video.addEventListener('play', event => {
            event.stopPropagation();
          });
        });
      });
    </script>
    <script type="module" src="{{site.basedir}}/{{site.hyperblampath}}"></script>
