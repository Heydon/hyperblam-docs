---
title: In a bad moog
bpm: 105
elements: 
  - Synth 
  - carrier
---

{% extends 'layouts/example-synth.njk' %}

{% block audio %}
<chain-blam id="bus">
  <reverb-blam mix="0.2" cutoff="1000">
    <sample-blam src="{{site.basedir}}/static/sounds/IRs/room-medium.mp3"></sample-blam>
  </reverb-blam>
  <gain-blam gain="1.5"></gain-blam>
  <analyser-blam id="analyser"></analyser-blam>
</chain-blam>

<synth-blam id="synth" gain="4" notes="C1 D#1 F1 G1 C1 C2 D#2 F2 C2 C3 D#3 F3 C3">
  <carrier-blam curve="0.03 0, 1 0.2" release="0.05" type="sawtooth">
    <modulator-blam class="mod" ratio="3.1" type="triangle" gain="0"></modulator-blam>
  </carrier-blam>
  <carrier-blam id="octave" curve="0.03 0, 1 0.2" release="0.05" type="sawtooth" offset="12" gain="0">
    <modulator-blam class="mod" ratio="2.7" type="square" gain="0"></modulator-blam>
  </carrier-blam>
  <chain-blam out="bus">
    <filter-blam type="bandpass" freq="1000" q="3">
      <envelope-blam prop="freq" curve="200 0, 5000 0.666, 500 1"></envelope-blam>
      <lfo-blam prop="freq" gain="100"></lfo-blam>
      <lfo-blam prop="freq" gain="100" beats="2.3"></lfo-blam>
    </filter-blam>
    <filter-blam type="highpass" freq="200"></filter-blam>
  </chain-blam>
  <lfo-blam prop="detune" gain="25" beats="0.7"></lfo-blam>
  <lfo-blam prop="detune" gain="20" beats="1.3"></lfo-blam>
</synth-blam>

<chain-blam id="drums" out="bus">
  <gain-blam gain="1.5"></gain-blam>
  <saturator-blam amount="30" lowcut="60"></saturator-blam>
</chain-blam>

<pad-blam id="kick" out="drums">
  <bank-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/kick/01.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/kick/02.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/kick/03.mp3"></sample-blam>
  </bank-blam>
</pad-blam>

<pad-blam class="snare" out="drums">
  <bank-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/snare-hard/01.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/snare-hard/02.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/snare-hard/03.mp3"></sample-blam>
  </bank-blam>
</pad-blam>

<pad-blam class="snare" gain="3">
  <bank-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/chocolate/clap/01.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/chocolate/clap/02.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/chocolate/clap/03.mp3"></sample-blam>
  </bank-blam>
  <chain-blam out="drums">
    <reverb-blam mix="0.05">
      <sample-blam src="{{site.basedir}}/static/sounds/IRs/yamaha-spring-hard.mp3"></sample-blam>
    </reverb-blam>
  </chain-blam>
</pad-blam>

<pad-blam id="snareSoft" out="drums">
  <bank-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/snare-soft/01.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/snare-soft/02.mp3"></sample-blam>
  </bank-blam>
</pad-blam>

<pad-blam id="hat" choke="0.05" out="drums">
  <bank-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/hat/01.mp3"></sample-blam>
    <sample-blam src="{{site.basedircdn}}/static/sounds/kit-garage/hat/02.mp3"></sample-blam>
  </bank-blam>
  <blam-blam prop="detune" value="0~60"></blam-blam>
</pad-blam>

<sequencer-blam swing="0.2">
  <track-blam to="#synth">
    <bar-blam s="C2 0 0 0 0 0 0 0"></bar-blam>
    <bar-blam chance="0.5" s="? ? ? ? ? ? ? ?"></bar-blam>
    <bar-blam s="D#1 0 0 0 0 0 0 0"></bar-blam>
    <bar-blam chance="0.5" s="? 0 ? 0 ? 0 0 0"></bar-blam>
  </track-blam> 
  <track-blam to="#hat">
    <bar-blam s="? 0"></bar-blam>
  </track-blam>
  <track-blam to="#hat" chance="0.25">
    <bar-blam s="0 ?"></bar-blam>
  </track-blam>
  <track-blam to=".snare">
    <bar-blam s="0 0 0 0 ? 0 0 0"></bar-blam>
    <bar-blam s="0 0 0 0 ? 0 0 0"></bar-blam>
  </track-blam>
  <track-blam to="#snareSoft">
    <bar-blam chance="0.8" s="0 ? 0 0 0 0 0 ?"></bar-blam>
    <bar-blam s="0 ? 0 0 0 0 0 ?"></bar-blam>
  </track-blam>
  <track-blam to="#kick">
    <bar-blam s="? 0 ? 0 0 0 0 0"></bar-blam>
    <bar-blam s="0 0 ? 0 0 0 0 0"></bar-blam>
  </track-blam>
</sequencer-blam>

<tap-blam to="sequencer-blam" prop="playStop">
  <button aria-pressed="false" class="u-round" aria-label="play">{% icon 'playStop' %}</button>
  <blam-blam to="#nearfisa" prop="stop"></blam-blam>
  <blam-blam to="rings-blam" prop="startStop"></blam-blam>
</tap-blam>
{% endblock %}

{% block dialog %}

{% renderTemplate "md" %}

As you’ll read in the [**Synthesis guide**](/guides/synthesis), I set out to capture the wild moog sound played by James Brown on [Blow Your Head](https://www.youtube.com/watch?v=vEaO7De2K40&list=RDvEaO7De2K40&start_radio=1).

Since then, I’ve made some modifications to enable an even nastier sound. These include a second `<carrier-blam>` used as a harmonizer, creating an octave overtone. 

```html 
<synth-blam id="synth" gain="4" notes="C1 D#1 F1 G1 C1 C2 D#2 F2 C2 C3 D#3 F3 C3">
  <carrier-blam curve="0.03 0, 1 0.2" release="0.05" type="sawtooth">
    <modulator-blam class="mod" ratio="3.1" type="triangle" gain="0"></modulator-blam>
  </carrier-blam>
  <carrier-blam id="octave" curve="0.03 0, 1 0.2" release="0.05" type="sawtooth" offset="12" gain="0">
    <modulator-blam class="mod" ratio="2.7" type="square" gain="0"></modulator-blam>
  </carrier-blam>
</synth-blam>
```

As you can see, there are also `<modulator-blam>` elements in place. These modulate the frequency of their parent `<carrier-blam>`s. Given the non-integer `ratio`s, and depending on the gain, this can really mess with the sound. Use the **instability** slider to try it out.

The drums here use the sample-based `<pad-blam>` instrument. Yep: there's no reason why you can’t mix sampling and synthesis within **HYPERBLAM**. Also, check out that lush spring reverb applied to the clap samples.

```html 
  <chain-blam out="drums">
    <reverb-blam mix="0.15">
      <sample-blam src="{{site.basedir}}/static/sounds/IRs/yamaha-spring-hard.mp3"></sample-blam>
    </reverb-blam>
  </chain-blam>
```

{% endrenderTemplate %}

{% endblock %}

{% block controls %}
<tap-blam to="synth-blam" prop="play">
  <button>blast</button>
</tap-blam>
<dial-blam to="synth-blam" prop="gain">
  <label>
    level
    <input type="range" min="0" max="4" step="0.1">
  </label>
</dial-blam>
<switch-blam to="#octave" prop="gain" value="0.75" ramp="3">
  <label>
    octaver
    <input type="checkbox">
  </label>
</switch-blam>
<dial-blam to=".mod" prop="gain">
  <label>
    instability
    <input type="range" min="0" max="1000">
  </label>
</dial-blam>
{% endblock %}