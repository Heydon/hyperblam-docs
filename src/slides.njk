              <div class="l-cluster">
                <tap-blam to="#bassNormal" prop="play" value="E2">
                  <button>normal</button>
                </tap-blam>
                <tap-blam to="#bassSlide" prop="play" value="E2">
                  <button>slide</button>
                </tap-blam>
              </div>
            </div>
          </div>
          <blam-blam from="#bassSlide" prop="class" value="u-slide" to=".bass-hand"></blam-blam>
          <blam-blam from="#bassNormal, #bassSlide" prop="class" value="u-jolt-small" to="#bassDrawing"></blam-blam>
        </section>

        <section id="envDiagram" class="u-no-stab">
          <div class="l-screen">
            <div class="l-frame">
              <img class="u-squiggle" src="{{site.basedir}}/static/images/slides/envelope2.svg" alt="diagram of envelope curve">
            </div>
          </div>
        </section>

        <section class="u-no-stab">
          <div class="l-screen">
            <media-blam out="garbleBus">
              <video onloadstart="this.volume=0.7" src="{{site.basedir}}/static/video/creative_drums_1.mp4"></video>
            </media-blam>
          </div>
          <blam-blam to="#bassTrack" for="slideWaiting" prop="suspend" false></blam-blam>
        </section> 

        <section id="organGhost" class="u-no-stab">
          <div id="babyBass" class="l-screen">
            <media-blam out="garbleBus">
              <video id="babyBassVid" class="u-contrast" style="transform: scale(1.5)" src="{{site.basedir}}/static/video/baby.mp4" loop></video>
            </media-blam>
          </div>
          <div class="l-frame l-cluster" style="justify-content: space-around">
            <switch-blam to="#organTrack" prop="suspend" style="font-size: 0.8em" reverse>
              <label>
                organ<br>chords
                <input type="checkbox">
              </label>
            </switch-blam>
            <switch-blam to="#snareGhostTrack, #hatTrack" prop="suspend" style="font-size: 0.8em" reverse>
              <label>
                ghost<br>snare
                <input type="checkbox">
              </label>
            </switch-blam>
          </div>
          <blam-blam from="#snare" to="#babyBassVid" prop="class" value="u-punch"></blam-blam>
          <blam-blam from="#organ" to="#babyBass" prop="class" value="u-squiggle-1"></blam-blam>
          <blam-blam to=".rhodesTrack" prop="solo" value="false" for="slideNext"></blam-blam>
          <blam-blam to="#cowbellTrack" prop="chance" value="0" for="slideNext"></blam-blam>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="true"></blam-blam>
        </section>

<!-- visualizations -->
        <section class="u-no-stab">
          <div class="l-screen">
            <freqs-blam 
              hidden
              analyser="#bossAnalyser"
              id="freqs"
              fps="8"
              ratio="1/1"
            >
            </freqs-blam>
            <div class="l-frame">
              <log-blam from="#freqs" style="white-space: pre; font-size: 0.6em" mode="props">[[css]]</log-blam>
            </div>
          </div>
          <blam-blam to="#subdueBus" for="slideNext" prop="bypass" value="false"></blam-blam>
          <blam-blam to="#freqsData" prop="start" for="slideNext"></blam-blam>
        </section>

