      <sample-blam src="{{site.basedircdn}}/static/sounds/dissonant/violin/03.mp3" reverse></sample-blam>
      <sample-blam src="{{site.basedircdn}}/static/sounds/dissonant/violin/04.mp3" reverse></sample-blam>
